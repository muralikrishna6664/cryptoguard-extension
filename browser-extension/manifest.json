{
  "manifest_version": 3,
  "name": "CryptoGuard",
  "version": "1.0.0",
  "description": "Behavioral detection for browser-based cryptojacking.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "notifications", "alarms", "webNavigation", "declarativeNetRequest"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "mining_pool_domains",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "CryptoGuard",
    "default_popup": "popup.html"
  }
}